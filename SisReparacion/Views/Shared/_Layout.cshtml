<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Reparaciones</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    Sistema de Reparaciones
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="menuPrincipal">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">Inicio</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Clientes"
                               asp-action="Index">Clientes</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Tecnicos"
                               asp-action="Index">Técnicos</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Electrodomesticos"
                               asp-action="Index">Electrodomésticos</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Reparaciones"
                               asp-action="Index">Reparaciones</a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-3">
            &copy; 2026 - Sistema de Reparaciones
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>