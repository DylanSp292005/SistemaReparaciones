@model SistemaReparaciones.Models.Electrodomestico

@{
    ViewData["Title"] = "Eliminar Electrodoméstico";
}

<h1>Eliminar Electrodoméstico</h1>

<h3 class="text-danger">¿Estás seguro de que deseas eliminar este electrodoméstico?</h3>

<div>
    <h4>Información del electrodoméstico</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Tipo</dt>
        <dd class="col-sm-9">@Model.Tipo</dd>

        <dt class="col-sm-3">Modelo</dt>
        <dd class="col-sm-9">@Model.Modelo</dd>

        <dt class="col-sm-3">Precio</dt>
        <dd class="col-sm-9">@Model.Precio.ToString("C")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
