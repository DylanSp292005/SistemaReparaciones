@model SistemaReparaciones.Models.Electrodomestico

@{
    ViewData["Title"] = "Detalles del Electrodoméstico";
}

<h1>Detalles del Electrodoméstico</h1>

<div>
    <h4>Información del electrodoméstico</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Tipo</dt>
        <dd class="col-sm-9">@Model.Tipo</dd>

        <dt class="col-sm-3">Modelo</dt>
        <dd class="col-sm-9">@Model.Modelo</dd>

        <dt class="col-sm-3">Precio</dt>
        <dd class="col-sm-9">@Model.Precio.ToString("C")</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
