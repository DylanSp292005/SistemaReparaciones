@model SistemaReparaciones.Models.Reparacion

@{
    ViewData["Title"] = "Registrar Reparación";
}

<h1>Registrar Reparación</h1>

<h4>Datos de la reparación</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="control-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Fecha" class="control-label">Fecha</label>
                <input asp-for="Fecha" type="date" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Hora" class="control-label">Hora</label>
                <input asp-for="Hora" type="time" class="form-control" />
                <span asp-validation-for="Hora" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Coste" class="control-label">Coste</label>
                <input asp-for="Coste" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Coste" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Garantia" class="control-label">¿Tiene garantía?</label>
                <input asp-for="Garantia" type="checkbox" class="form-check-input ms-2" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClienteId">Cliente</label>
                <select asp-for="ClienteId" asp-items="ViewBag.ClienteId" class="form-select">
                    <option value="">Seleccione un cliente</option>
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TecnicoId">Técnico</label>
                <select asp-for="TecnicoId" asp-items="ViewBag.TecnicoId" class="form-select">
                    <option value="">Seleccione un técnico</option>
                </select>
                <span asp-validation-for="TecnicoId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ElectrodomesticoId">Electrodoméstico</label>
                <select asp-for="ElectrodomesticoId" asp-items="ViewBag.ElectrodomesticoId" class="form-select">
                    <option value="">Seleccione un electrodoméstico</option>
                </select>
                <span asp-validation-for="ElectrodomesticoId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

